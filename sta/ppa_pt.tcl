# CXL scheduler PPA preparation flow: PrimeTime STA of the DC netlist/SDC in ONE prepared syn run.
# Use only through the run.sh generated by scripts/prepare_ppa_run.py, after ppa_dc.tcl completed.
# It reads exactly output/switch_top.syn.v and output/switch_top.syn.sdc written by DC, links with
# black-box creation disabled, applies the same library corner and wire-load methodology from the
# reviewed profile and adds no timing exception. Pre-layout only; power is NOT_RUN.
# Pilot candidate: the first real FastX pilot logs must confirm command behavior. The marker
# reports/pt_status.rpt is written only after every step returned; run.sh still checks the logs.

set RUN_ROOT [file dirname [file dirname [file normalize [info script]]]]
cd $RUN_ROOT
source [file join $RUN_ROOT run_config.tcl]

# pt_shell -f echoes each top-level command and its return value (observed on FastX). The failure
# tag is therefore assembled inside a proc: neither the source line nor any top-level result is it.
proc ppa_fail_tag {} {return "EDA_[string toupper failure]"}
set PPA_STEPS reports/pt_steps.rpt

proc ppa_fail {message} {error $message}

# LF output on every platform, so markers compare byte-for-byte with expected/*.rpt.
proc ppa_write {path content {access w}} {
    set handle [open $path $access]
    fconfigure $handle -translation lf
    puts -nonewline $handle $content
    close $handle
}

proc ppa_tool_messages {content} {
    return [regexp -all -line -inline {^\s*(?:Error|Fatal)\s*:.*$} $content]
}

# A Tcl error or a literal 0 result fails the run; other results get semantic checks afterwards.
proc ppa_step {name script} {
    if {[catch {uplevel #0 $script} result]} {ppa_fail "$name raised: $result"}
    ppa_write $::PPA_STEPS "$name result=[string range $result 0 200]\n" a
    if {$result eq "0"} {ppa_fail "$name returned 0"}
    return $result
}

proc ppa_report {file script {required 1}} {
    set ::ppa_capture_text ""
    if {[catch {uplevel #0 [list redirect -variable ppa_capture_text $script]} result]} {
        ppa_fail "$file raised: $result"
    }
    set content $::ppa_capture_text
    ppa_write [file join reports $file] "# command: $script\n$content"
    set messages [ppa_tool_messages $content]
    if {[llength $messages]} {ppa_fail "$file reported: [lindex $messages 0]"}
    if {$required && [string trim $content] eq ""} {ppa_fail "$file produced no output"}
    return $content
}

proc ppa_optional_report {file command script} {
    if {[llength [info commands $command]]} {
        ppa_report $file $script 0
    } else {
        ppa_write [file join reports $file] "# $command NOT_FOUND in this tool; report not produced\n"
    }
}

proc ppa_command_inventory {file names} {
    set content ""
    foreach name $names {
        if {[llength [info commands $name]]} {
            append content "$name AVAILABLE\n"
        } else {
            append content "$name NOT_FOUND\n"
        }
    }
    ppa_write [file join reports $file] $content
}

proc ppa_variable_report {file names {prefix ""}} {
    set content $prefix
    foreach name $names {
        if {[info exists ::$name] && ![catch {set ::$name} value]} {
            append content "$name = $value\n"
        } else {
            append content "$name NOT_VISIBLE\n"
        }
    }
    ppa_write [file join reports $file] $content
}

proc ppa_count {pattern} {
    return [sizeof_collection [get_cells -hierarchical -quiet -filter "ref_name=~$pattern"]]
}

# Confirms the netlist is the requested N/policy configuration; register counts are for review.
proc ppa_structure_check {file} {
    set content "phase = pt_netlist\nconfiguration = $::ELAB_PARAMETERS\ncurrent_design = [get_object_name [current_design]]\n"
    set problems {}
    foreach {port bits} $::EXPECT_PORT_BITS {
        set actual [sizeof_collection [get_ports -quiet "${port}*"]]
        append content "port $port bits = $actual (expected $bits)\n"
        if {$actual != $bits} {lappend problems "port $port has $actual bits, expected $bits"}
    }
    foreach {label pattern expected} [list fifo cxl_desc_fifo* $::EXPECT_FIFO_INSTANCES \
                                          out_hold cxl_out_hold* $::EXPECT_OUT_HOLD_INSTANCES] {
        set actual [ppa_count $pattern]
        append content "instances $label ($pattern) = $actual (expected $expected)\n"
        if {$actual != $expected} {lappend problems "$label instances $actual, expected $expected"}
    }
    set actual [ppa_count "$::EXPECT_POLICY_MODULE*"]
    append content "policy module $::EXPECT_POLICY_MODULE instances = $actual (expected >= 1)\n"
    if {$actual < 1} {lappend problems "policy module $::EXPECT_POLICY_MODULE missing"}
    foreach module $::FORBIDDEN_POLICY_MODULES {
        set actual [ppa_count "$module*"]
        append content "forbidden module $module instances = $actual (expected 0)\n"
        if {$actual != 0} {lappend problems "forbidden policy module $module present"}
    }
    set total [sizeof_collection [all_registers]]
    set latches [sizeof_collection [all_registers -level_sensitive]]
    append content "registers all = $total level_sensitive = $latches (counts for review)\n"
    if {$latches != 0} {lappend problems "$latches level-sensitive registers (latches) found"}
    if {[llength $problems]} {
        append content "STRUCTURE_CHECK = INCONSISTENT\n"
        ppa_write [file join reports $file] $content
        ppa_fail "structure check (pt_netlist): [join $problems {; }]"
    }
    append content "STRUCTURE_CHECK = CONSISTENT\n"
    ppa_write [file join reports $file] $content
}

proc ppa_apply_methodology {} {
    ppa_step set_operating_conditions {set_operating_conditions -library $LIB_NAME $OPERATING_CONDITIONS}
    switch -- $::WIRE_LOAD_METHOD {
        fixed_model {
            if {[info exists ::auto_wire_load_selection]} {
                ppa_step auto_wire_load_selection {set_app_var auto_wire_load_selection false}
            }
            ppa_step set_wire_load_mode {set_wire_load_mode $WIRE_LOAD_MODE}
            ppa_step set_wire_load_model {set_wire_load_model -name $WIRE_LOAD_MODEL -library $LIB_NAME}
        }
        zero_wireload {
            if {![llength [info commands set_zero_interconnect_delay_mode]]} {
                ppa_fail "zero_wireload needs set_zero_interconnect_delay_mode, which this tool does not provide"
            }
            ppa_step set_zero_interconnect_delay_mode {set_zero_interconnect_delay_mode true}
        }
        default {ppa_fail "unknown wire-load method $::WIRE_LOAD_METHOD"}
    }
}

# Same parsing as ppa_dc.tcl: "Time_unit : 1e-09 Second" / "Capacitive_load_unit : 1e-15 Farad".
proc ppa_units {file} {
    set text [ppa_report $file {report_units}]
    foreach {key pattern} {time {Time_unit\s*:\s*([-+0-9.eE]+)\s*Second}
                           cap {Capacitive_load_unit\s*:\s*([-+0-9.eE]+)\s*Farad}} {
        if {![regexp -line $pattern $text -> value] || ![string is double -strict $value] || $value <= 0} {
            ppa_fail "report_units shows no parsable $key unit"
        }
        set ::PPA_UNIT($key) $value
    }
}

proc ppa_check_profile_units {} {
    foreach {key declared} [list time $::UNIT_TIME cap $::UNIT_CAP] {
        if {![regexp {^([0-9]+)(ps|ns|ff|pf)$} $declared -> number unit]} {
            ppa_fail "profile unit $declared is not understood"
        }
        set expected [expr {$number * [dict get {ps 1e-12 ns 1e-9 ff 1e-15 pf 1e-12} $unit]}]
        if {abs($::PPA_UNIT($key) - $expected) > 1e-6 * $expected} {
            ppa_fail "profile declares $key unit $declared but report_units shows $::PPA_UNIT($key)"
        }
    }
}

# Mandatory timing reports must hold real path records, not only a "No paths" message.
proc ppa_paths {file content} {
    if {![regexp -line {^\s*Startpoint:} $content] || ![regexp {slack\s*\((MET|VIOLATED)} $content]} {
        ppa_fail "$file contains no timing path records"
    }
}

# Exact counts from the "All Checks" row; rounded percentages never count as complete coverage.
proc ppa_coverage_summary {text} {
    set content "# derived from pt_coverage.rpt; percentages are rounded by the tool and are not used\n"
    set number {\s+(\d+)(?:\s*\([^)]*\))?}
    if {[regexp -line "^\\s*All Checks$number$number$number$number" $text -> total met violated untested]} {
        append content "all_checks_total = $total\nmet = $met\nviolated = $violated\nuntested = $untested\n"
        if {$met + $violated + $untested != $total} {
            set status COUNTS_DO_NOT_ADD_UP_REVIEW_REQUIRED
        } elseif {$violated > 0} {
            set status VIOLATED_CHECKS_PRESENT_REVIEW_REQUIRED
        } elseif {$untested > 0} {
            set status UNTESTED_CHECKS_PRESENT_REVIEW_REQUIRED
        } else {
            set status ALL_CHECKS_TESTED_AND_MET
        }
    } else {
        set status NOT_PARSED_REVIEW_REQUIRED
    }
    append content "details = pt_coverage_untested.rpt (untested checks), pt_disable_timing.rpt (disabled arcs)\n"
    append content "ANALYSIS_COVERAGE = $status\n"
    ppa_write reports/pt_coverage_summary.rpt $content
}

proc ppa_main {} {
    file mkdir reports
    ppa_write $::PPA_STEPS "# PT steps for $::RUN_NAME\n"
    set version_prefix "tcl_patchlevel = [info patchlevel]\nexecutable = [info nameofexecutable]\n"
    ppa_variable_report pt_versions.rpt {sh_product_version sh_arch} $version_prefix
    ppa_command_inventory pt_commands.rpt {
        read_verilog link_design current_design read_sdc set_operating_conditions set_wire_load_model
        set_wire_load_mode set_zero_interconnect_delay_mode update_timing check_timing report_timing
        report_constraint report_analysis_coverage report_disable_timing report_global_timing
        report_exceptions report_units report_design report_clock all_registers redirect report_power
        read_saif read_vcd
    }
    ppa_step search_path {set_app_var search_path [concat [list $RUN_ROOT [file dirname $TARGET_LIBRARY]] $search_path]}
    ppa_step link_path {set_app_var link_path [list * $TARGET_LIBRARY]}
    # Linking must stop on a missing module; it may not substitute an empty cell for it.
    ppa_step link_create_black_boxes {set_app_var link_create_black_boxes false}
    foreach path [list $::NETLIST_FILE $::SDC_FILE] {
        if {![file isfile $path] || [file size $path] == 0} {ppa_fail "$path from DC is missing"}
    }
    ppa_step read_verilog {read_verilog $NETLIST_FILE}
    # PrimeTime links the read netlist by top name; link_design also makes it the current design.
    ppa_step link_design {link_design $TOP_MODULE}
    if {[get_object_name [current_design]] ne $::TOP_MODULE} {
        ppa_fail "current design after link_design is not $::TOP_MODULE"
    }
    if {[sizeof_collection [get_libs -quiet $::LIB_NAME]] != 1} {
        ppa_fail "profile library $::LIB_NAME is not linked"
    }
    ppa_step read_sdc {read_sdc $SDC_FILE}
    ppa_apply_methodology
    ppa_variable_report pt_app_vars.rpt {
        link_path search_path link_create_black_boxes auto_wire_load_selection
        timing_remove_clock_reconvergence_pessimism timing_enable_preset_clear_arcs
    } "profile_id = $::PROFILE_ID\nprofile_status = $::PROFILE_STATUS\nprofile_canonical_sha256 = $::PROFILE_SHA256\n"
    ppa_structure_check pt_structure.rpt
    ppa_step update_timing {update_timing -full}
    ppa_units pt_units.rpt
    ppa_check_profile_units
    ppa_report pt_design.rpt {report_design}
    ppa_report pt_clocks.rpt {report_clock}
    ppa_report pt_check_timing.rpt {check_timing -verbose} 0
    # -significant_digits 6 -nosplit (observed accepted by W-2024.09 PT) keeps ~0.001 violations visible.
    # PT otherwise applies -slack_lesser_than 0 and prints only "No paths ..." when timing is met.
    # -slack_lesser_than 1e9 is a report filter only (no constraint change) so met paths are listed.
    ppa_paths pt_timing_max.rpt [ppa_report pt_timing_max.rpt {report_timing -delay_type max -max_paths 20 -slack_lesser_than 1e9 -significant_digits 6 -nosplit}]
    ppa_paths pt_timing_min.rpt [ppa_report pt_timing_min.rpt {report_timing -delay_type min -max_paths 20 -slack_lesser_than 1e9 -significant_digits 6 -nosplit}]
    ppa_report pt_constraints.rpt {report_constraint -all_violators -significant_digits 6 -nosplit}
    set coverage [ppa_report pt_coverage.rpt {report_analysis_coverage}]
    ppa_report pt_coverage_untested.rpt {report_analysis_coverage -status_details untested} 0
    ppa_coverage_summary $coverage
    ppa_optional_report pt_disable_timing.rpt report_disable_timing {report_disable_timing}
    ppa_optional_report pt_global_timing.rpt report_global_timing {report_global_timing}
    ppa_optional_report pt_exceptions.rpt report_exceptions {report_exceptions}
    ppa_write reports/pt_status.rpt [format "PT_STATUS: COMMANDS_COMPLETED\nRUN: %s\nTOP: %s\nNETLIST: %s\nSDC: %s\n" \
        $::RUN_NAME $::TOP_MODULE $::NETLIST_FILE $::SDC_FILE]
}

if {[catch {ppa_main} ppa_detail]} {
    puts "[ppa_fail_tag]: $ppa_detail"
    exit 1
}
exit 0
