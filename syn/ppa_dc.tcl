# CXL scheduler PPA preparation flow: Design Compiler probe/syn for ONE prepared run directory.
# Use only through the run.sh generated by scripts/prepare_ppa_run.py. The run_config.tcl beside it
# supplies explicit parameters and, in syn mode, the reviewed profile. This file holds no numeric
# timing/load value and no library content.
#   probe: read_db, library name/attributes, analyze, parameterized elaborate, rename to switch_top,
#          link, report_units, structural checks, design/port reports. No compile and no PPA result.
#   syn:   probe steps, profile methodology and constraints, compile, reports, netlist and SDC.
# Pilot candidate: the first real FastX probe/pilot logs must confirm command behavior. The marker
# reports/dc_status.rpt is written only after every step returned; run.sh still checks the logs.

set RUN_ROOT [file dirname [file dirname [file normalize [info script]]]]
cd $RUN_ROOT
source [file join $RUN_ROOT run_config.tcl]

# dc_shell -f echoes each top-level command and its return value (observed on FastX). The failure
# tag is therefore assembled inside a proc: neither the source line nor any top-level result is it.
proc ppa_fail_tag {} {return "EDA_[string toupper failure]"}
set PPA_STEPS reports/dc_steps.rpt

proc ppa_fail {message} {error $message}

# LF output on every platform, so markers compare byte-for-byte with expected/*.rpt.
proc ppa_write {path content {access w}} {
    set handle [open $path $access]
    fconfigure $handle -translation lf
    puts -nonewline $handle $content
    close $handle
}

# Tool message lines of error or fatal severity inside captured command output.
proc ppa_tool_messages {content} {
    return [regexp -all -line -inline {^\s*(?:Error|Fatal)\s*:.*$} $content]
}

# Runs one required command in the global scope. A Tcl error or a literal 0 result fails the run;
# any other result is not trusted as success by itself, so callers add semantic checks.
proc ppa_step {name script} {
    if {[catch {uplevel #0 $script} result]} {ppa_fail "$name raised: $result"}
    ppa_write $::PPA_STEPS "$name result=[string range $result 0 200]\n" a
    if {$result eq "0"} {ppa_fail "$name returned 0"}
    return $result
}

proc ppa_capture {name script} {
    set ::ppa_capture_text ""
    if {[catch {uplevel #0 [list redirect -variable ppa_capture_text $script]} result]} {
        ppa_fail "$name raised: $result"
    }
    return $::ppa_capture_text
}

proc ppa_check_capture {name content required} {
    set messages [ppa_tool_messages $content]
    if {[llength $messages]} {ppa_fail "$name reported: [lindex $messages 0]"}
    if {$required && [string trim $content] eq ""} {ppa_fail "$name produced no output"}
}

# Saves a report before checking it, so failing output stays available for review.
proc ppa_report {file script {required 1}} {
    set content [ppa_capture $file $script]
    ppa_write [file join reports $file] "# command: $script\n$content"
    ppa_check_capture $file $content $required
    return $content
}

proc ppa_command_inventory {file names} {
    set content ""
    foreach name $names {
        if {[llength [info commands $name]]} {
            append content "$name AVAILABLE\n"
        } else {
            append content "$name NOT_FOUND\n"
        }
    }
    ppa_write [file join reports $file] $content
}

proc ppa_variable_report {file names {prefix ""}} {
    set content $prefix
    foreach name $names {
        if {[info exists ::$name] && ![catch {set ::$name} value]} {
            append content "$name = $value\n"
        } else {
            append content "$name NOT_VISIBLE\n"
        }
    }
    ppa_write [file join reports $file] $content
}

# Library facts without report_lib: its redirected text was observed empty on W-2024.09 DC. The
# loaded library must be named after the .db file root; the observed attributes time_unit_name and
# capacitive_load_units are recorded. Units are confirmed from report_units after link.
proc ppa_library_facts {} {
    ppa_step read_db {read_db $::TARGET_LIBRARY}
    ppa_report lib_list.rpt {list_libs} 0
    set name [file rootname $::TARGET_LIBRARY_BASENAME]
    set ::PPA_LOADED_LIBS [get_object_name [get_libs -quiet *]]
    if {[lsearch -exact $::PPA_LOADED_LIBS $name] < 0} {
        ppa_fail "no loaded library is named $name after read_db (loaded: $::PPA_LOADED_LIBS)"
    }
    set ::PPA_LIB_NAME $name
    set ::ppa_lib_name $name
    foreach attr {time_unit_name capacitive_load_units} {
        set ::ppa_attr_value ""
        set text [ppa_capture "get_attribute $attr" \
            "set ::ppa_attr_value \[get_attribute \[get_libs \$::ppa_lib_name\] $attr\]"]
        ppa_check_capture "get_attribute $attr" $text 0
        if {[string trim $::ppa_attr_value] eq ""} {ppa_fail "library attribute $attr is empty"}
        set ::PPA_LIB_ATTR($attr) [string trim $::ppa_attr_value]
    }
}

# Shared with ppa_pt.tcl: report_units prints "Time_unit : 1.0e-09 Second(ns)" in DC and
# "Time_unit : 1e-09 Second" in PT; the value in seconds/farads is parsed from either form.
proc ppa_units {file} {
    set text [ppa_report $file {report_units}]
    foreach {key pattern} {time {Time_unit\s*:\s*([-+0-9.eE]+)\s*Second}
                           cap {Capacitive_load_unit\s*:\s*([-+0-9.eE]+)\s*Farad}} {
        if {![regexp -line $pattern $text -> value] || ![string is double -strict $value] || $value <= 0} {
            ppa_fail "report_units shows no parsable $key unit"
        }
        set ::PPA_UNIT($key) $value
    }
}

# Declared or attribute unit text such as 1ns, 10ps, 1ff, 1.000000ff -> seconds/farads, or "".
proc ppa_unit_value {text} {
    if {![regexp -nocase {^\s*([0-9]*\.?[0-9]*)\s*(ps|ns|ff|pf)\s*$} $text -> number unit]} {return ""}
    if {$number eq "" || $number eq "."} {set number 1}
    set scale [dict get {ps 1e-12 ns 1e-9 ff 1e-15 pf 1e-12} [string tolower $unit]]
    return [expr {$number * $scale}]
}

proc ppa_same_value {a b} {return [expr {abs($a - $b) <= 1e-6 * abs($b)}]}

proc ppa_library_metadata {} {
    set content "# library metadata only; no cell or timing-table data is stored\n"
    append content "library_name = $::PPA_LIB_NAME\nidentified_by = loaded library named after the .db file root (read_db, get_libs)\n"
    append content "library_file = $::TARGET_LIBRARY\nloaded_libraries = $::PPA_LOADED_LIBS\n"
    foreach {attr key} {time_unit_name time capacitive_load_units cap} {
        set value [ppa_unit_value $::PPA_LIB_ATTR($attr)]
        if {$value eq ""} {
            set verdict NOT_PARSED_RECORDED_ONLY
        } elseif {[ppa_same_value $value $::PPA_UNIT($key)]} {
            set verdict CONSISTENT_WITH_REPORT_UNITS
        } else {
            ppa_fail "library attribute $attr = $::PPA_LIB_ATTR($attr) contradicts report_units $::PPA_UNIT($key)"
        }
        append content "attribute $attr = $::PPA_LIB_ATTR($attr) ($verdict)\n"
    }
    append content "report_units time_unit_seconds = $::PPA_UNIT(time)\nreport_units capacitive_load_unit_farads = $::PPA_UNIT(cap)\n"
    append content "report_lib = NOT_USED (redirected report_lib text was observed empty on W-2024.09 DC)\n"
    append content "operating_conditions_and_wire_load = see elab_design.rpt (report_design after link)\n"
    ppa_write reports/lib_metadata.rpt $content
}

proc ppa_elaborate {} {
    file mkdir work
    ppa_step define_design_lib {define_design_lib WORK -path [file join $RUN_ROOT work]}
    ppa_step analyze {analyze -format sverilog -library WORK $RTL_FILES}
    ppa_step elaborate {elaborate $TOP_MODULE -library WORK -parameters $ELAB_PARAMETERS}
    # The parameterized design may carry a parameter suffix; downstream names use switch_top.
    set actual [get_object_name [current_design]]
    ppa_write $::PPA_STEPS "elaborated_current_design=$actual\n" a
    if {$actual ne $::TOP_MODULE && [string first "${::TOP_MODULE}_" $actual] != 0} {
        ppa_fail "elaborated current design '$actual' is not a parameterized $::TOP_MODULE"
    }
    if {$actual ne $::TOP_MODULE} {
        if {[sizeof_collection [get_designs -quiet $::TOP_MODULE]] != 0} {
            ppa_fail "a design named $::TOP_MODULE already exists beside elaborated $actual"
        }
        set ::ppa_elaborated_top $actual
        ppa_step rename_design {rename_design $ppa_elaborated_top $TOP_MODULE}
    }
    ppa_step current_design {current_design $TOP_MODULE}
    if {[get_object_name [current_design]] ne $::TOP_MODULE} {
        ppa_fail "current design is not $::TOP_MODULE after renaming"
    }
    ppa_step link {link}
}

proc ppa_count {pattern} {
    return [sizeof_collection [get_cells -hierarchical -quiet -filter "ref_name=~$pattern"]]
}

# registers: bounds = pre-compile storage bounds; report = counts only (latches still must be 0).
proc ppa_structure_check {file phase registers} {
    set content "phase = $phase\nconfiguration = $::ELAB_PARAMETERS\ncurrent_design = [get_object_name [current_design]]\n"
    set problems {}
    foreach {port bits} $::EXPECT_PORT_BITS {
        set actual [sizeof_collection [get_ports -quiet "${port}*"]]
        append content "port $port bits = $actual (expected $bits)\n"
        if {$actual != $bits} {lappend problems "port $port has $actual bits, expected $bits"}
    }
    foreach {label pattern expected} [list fifo cxl_desc_fifo* $::EXPECT_FIFO_INSTANCES \
                                          out_hold cxl_out_hold* $::EXPECT_OUT_HOLD_INSTANCES] {
        set actual [ppa_count $pattern]
        append content "instances $label ($pattern) = $actual (expected $expected)\n"
        if {$actual != $expected} {lappend problems "$label instances $actual, expected $expected"}
    }
    set actual [ppa_count "$::EXPECT_POLICY_MODULE*"]
    append content "policy module $::EXPECT_POLICY_MODULE instances = $actual (expected >= 1)\n"
    if {$actual < 1} {lappend problems "policy module $::EXPECT_POLICY_MODULE missing"}
    foreach module $::FORBIDDEN_POLICY_MODULES {
        set actual [ppa_count "$module*"]
        append content "forbidden module $module instances = $actual (expected 0)\n"
        if {$actual != 0} {lappend problems "forbidden policy module $module present"}
    }
    set total [sizeof_collection [all_registers]]
    set edge [sizeof_collection [all_registers -edge_triggered]]
    set latches [sizeof_collection [all_registers -level_sensitive]]
    append content "registers all = $total edge_triggered = $edge level_sensitive = $latches\n"
    if {$latches != 0} {lappend problems "$latches level-sensitive registers (latches) found"}
    if {$registers eq "bounds"} {
        append content "register lower bound (descriptor + required arrival storage) = $::EXPECT_MIN_REGISTER_BITS\n"
        if {$total < $::EXPECT_MIN_REGISTER_BITS} {
            lappend problems "register bits $total below required storage $::EXPECT_MIN_REGISTER_BITS"
        }
        if {$::EXPECT_MAX_REGISTER_BITS_EXCLUSIVE > 0} {
            append content "register upper bound exclusive (no timestamp bank) = $::EXPECT_MAX_REGISTER_BITS_EXCLUSIVE\n"
            if {$total >= $::EXPECT_MAX_REGISTER_BITS_EXCLUSIVE} {
                lappend problems "register bits $total reach the timestamp-bank bound $::EXPECT_MAX_REGISTER_BITS_EXCLUSIVE"
            }
        }
    } else {
        append content "register bounds not gated in this phase; counts are for review\n"
    }
    if {[llength $problems]} {
        append content "STRUCTURE_CHECK = INCONSISTENT\n"
        ppa_write [file join reports $file] $content
        ppa_fail "structure check ($phase): [join $problems {; }]"
    }
    append content "STRUCTURE_CHECK = CONSISTENT\n"
    ppa_write [file join reports $file] $content
}

proc ppa_check_profile_library {} {
    if {$::PPA_LIB_NAME ne $::LIB_NAME} {
        ppa_fail "profile library name $::LIB_NAME differs from loaded library $::PPA_LIB_NAME"
    }
    foreach {key declared} [list time $::UNIT_TIME cap $::UNIT_CAP] {
        set expected [ppa_unit_value $declared]
        if {$expected eq "" || ![ppa_same_value $::PPA_UNIT($key) $expected]} {
            ppa_fail "profile declares $key unit $declared but report_units shows $::PPA_UNIT($key)"
        }
    }
}

proc ppa_apply_methodology {} {
    ppa_step set_operating_conditions {set_operating_conditions -library $LIB_NAME $OPERATING_CONDITIONS}
    ppa_step auto_wire_load_selection {set_app_var auto_wire_load_selection false}
    switch -- $::WIRE_LOAD_METHOD {
        fixed_model {
            ppa_step set_wire_load_mode {set_wire_load_mode $WIRE_LOAD_MODE}
            ppa_step set_wire_load_model {set_wire_load_model -name $WIRE_LOAD_MODEL -library $LIB_NAME}
        }
        zero_wireload {
            if {![llength [info commands set_zero_interconnect_delay_mode]]} {
                ppa_fail "zero_wireload needs set_zero_interconnect_delay_mode, which this tool does not provide"
            }
            ppa_step set_zero_interconnect_delay_mode {set_zero_interconnect_delay_mode true}
        }
        default {ppa_fail "unknown wire-load method $::WIRE_LOAD_METHOD"}
    }
}

# rst_n is a normally timed synchronous input: no false path, no case analysis, no constant.
proc ppa_apply_constraints {} {
    ppa_step create_clock {create_clock -name $CLOCK_NAME -period $CLOCK_PERIOD [get_ports $CLOCK_PORT]}
    ppa_step set_clock_uncertainty_setup {set_clock_uncertainty -setup $CLOCK_SETUP_UNCERTAINTY [get_clocks $CLOCK_NAME]}
    ppa_step set_clock_uncertainty_hold {set_clock_uncertainty -hold $CLOCK_HOLD_UNCERTAINTY [get_clocks $CLOCK_NAME]}
    ppa_step set_clock_transition {set_clock_transition $CLOCK_TRANSITION [get_clocks $CLOCK_NAME]}
    set ::ppa_inputs [remove_from_collection [all_inputs] [get_ports $::CLOCK_PORT]]
    set timed [sizeof_collection $::ppa_inputs]
    if {$timed != $::EXPECT_TIMED_INPUT_BITS} {
        ppa_fail "timed input bits $timed, expected $::EXPECT_TIMED_INPUT_BITS"
    }
    if {[sizeof_collection [get_ports -quiet rst_n]] != 1
        || [sizeof_collection [remove_from_collection [get_ports rst_n] $::ppa_inputs]] != 0} {
        ppa_fail "rst_n is not in the normally timed input set"
    }
    ppa_step set_input_delay_max {set_input_delay -max $INPUT_DELAY_MAX -clock $CLOCK_NAME $ppa_inputs}
    ppa_step set_input_delay_min {set_input_delay -min $INPUT_DELAY_MIN -clock $CLOCK_NAME $ppa_inputs}
    ppa_step set_output_delay_max {set_output_delay -max $OUTPUT_DELAY_MAX -clock $CLOCK_NAME [all_outputs]}
    ppa_step set_output_delay_min {set_output_delay -min $OUTPUT_DELAY_MIN -clock $CLOCK_NAME [all_outputs]}
    ppa_step set_input_transition {set_input_transition $INPUT_TRANSITION $ppa_inputs}
    ppa_step set_load {set_load $OUTPUT_LOAD [all_outputs]}
}

proc ppa_profile_report {} {
    set content "profile_id = $::PROFILE_ID\nprofile_status = $::PROFILE_STATUS\nprofile_canonical_sha256 = $::PROFILE_SHA256\n"
    append content "library = $::LIB_NAME ($::TARGET_LIBRARY)\noperating_conditions = $::OPERATING_CONDITIONS\n"
    append content "time_unit = $::UNIT_TIME\ncapacitance_unit = $::UNIT_CAP\n"
    foreach name {CLOCK_PORT CLOCK_NAME} {append content "$name = [set ::$name]\n"}
    foreach name {CLOCK_PERIOD CLOCK_SETUP_UNCERTAINTY CLOCK_HOLD_UNCERTAINTY CLOCK_TRANSITION
                  INPUT_DELAY_MIN INPUT_DELAY_MAX OUTPUT_DELAY_MIN OUTPUT_DELAY_MAX INPUT_TRANSITION} {
        append content "$name = [set ::$name] ($::UNIT_TIME)\n"
    }
    append content "OUTPUT_LOAD = $::OUTPUT_LOAD ($::UNIT_CAP)\n"
    append content "timed_inputs = all inputs except $::CLOCK_PORT, including rst_n ($::EXPECT_TIMED_INPUT_BITS bits)\n"
    append content "wire_load = $::WIRE_LOAD_METHOD model=$::WIRE_LOAD_MODEL mode=$::WIRE_LOAD_MODE auto_wire_load_selection=false\n"
    append content "compile = compile map_effort=$::COMPILE_MAP_EFFORT max_cores=1\ntiming_exceptions = none\npower = NOT_RUN\n"
    ppa_write reports/profile_applied.rpt $content
}

proc ppa_area_summary {area} {
    set content "# extracted from reports/area.rpt (report_area, top level)\n"
    set values [dict create]
    foreach {key pattern} {
        combinational_area {Combinational area:\s+(\S+)}
        buf_inv_area {Buf/Inv area:\s+(\S+)}
        noncombinational_area {Noncombinational area:\s+(\S+)}
        macro_black_box_area {Macro/Black Box area:\s+(\S+)}
        net_interconnect_area {Net Interconnect area:\s+(\S+)}
        total_cell_area {Total cell area:\s+(\S+)}
        total_area {Total area:\s+(\S+)}
        number_of_ports {Number of ports:\s+(\S+)}
        number_of_nets {Number of nets:\s+(\S+)}
        number_of_cells {Number of cells:\s+(\S+)}
        number_of_combinational_cells {Number of combinational cells:\s+(\S+)}
        number_of_sequential_cells {Number of sequential cells:\s+(\S+)}
        number_of_macros_black_boxes {Number of macros/black boxes:\s+(\S+)}
        number_of_buf_inv {Number of buf/inv:\s+(\S+)}
        number_of_references {Number of references:\s+(\S+)}
    } {
        if {[regexp -line $pattern $area -> value]} {
            dict set values $key $value
            append content "$key = $value\n"
        } else {
            append content "$key = NOT_FOUND\n"
        }
    }
    set problems {}
    if {![dict exists $values total_cell_area] || ![string is double -strict [dict get $values total_cell_area]]
        || [dict get $values total_cell_area] <= 0} {
        lappend problems "total cell area missing or not positive"
    }
    foreach key {macro_black_box_area number_of_macros_black_boxes} {
        if {[dict exists $values $key] && (![string is double -strict [dict get $values $key]] || [dict get $values $key] != 0)} {
            lappend problems "$key is [dict get $values $key], expected 0 (no macro or black box)"
        }
    }
    if {![llength $problems] && [dict exists $values combinational_area] && [dict exists $values noncombinational_area]
        && [string is double -strict [dict get $values combinational_area]]
        && [string is double -strict [dict get $values noncombinational_area]]} {
        set total [dict get $values total_cell_area]
        set sum [expr {[dict get $values combinational_area] + [dict get $values noncombinational_area]}]
        if {[dict exists $values macro_black_box_area]} {set sum [expr {$sum + [dict get $values macro_black_box_area]}]}
        set delta [expr {$total - $sum}]
        append content "reconciliation total_cell_area - (combinational + noncombinational + macro/black box) = $delta\n"
        if {abs($delta) <= 1e-3 + 1e-9 * $total} {
            append content "AREA_RECONCILIATION = RECONCILED\n"
        } else {
            append content "AREA_RECONCILIATION = NOT_RECONCILED_REVIEW_REQUIRED\n"
        }
    } else {
        append content "AREA_RECONCILIATION = NOT_EVALUATED_REVIEW_REQUIRED\n"
    }
    append content "note = hierarchical breakdown is in area_hier.rpt; parent and child rows must not be summed twice\n"
    ppa_write reports/area_summary.rpt $content
    if {[llength $problems]} {ppa_fail "area check: [join $problems {; }]"}
}

# Optional optimization-only library limit overlay. The original .db is never written; every
# attempted edit is restored/read back before final reporting or the netlist/SDC handoff.
proc ppa_cap_write {pin value {original ""}} {
    set ::ppa_cap_pin $pin
    set ::ppa_cap_value $value
    set ::ppa_cap_result ""
    set text [ppa_capture cap_limit {set ::ppa_cap_result [set_attribute $::ppa_cap_pin max_capacitance $::ppa_cap_value]}]
    ppa_check_capture cap_limit $text 0
    if {$::ppa_cap_result eq "0"} {ppa_fail "setting library cap returned 0"}
    # Native W-2024.09 calibration: library attributes store float32 and get_attribute prints
    # six decimals (50.76502425 -> 50.765026). Predict that representation, not a loose tolerance.
    binary scan [binary format f $value] f rounded
    set expected [format %.6f $rounded]
    set actual [get_attribute $pin max_capacitance]
    if {![string is double -strict $actual] || !($actual > 0 && $actual < Inf) || $actual != $expected} {
        ppa_fail "library cap readback $actual differs from calibrated $expected (requested $value)"
    }
    if {$original ne "" && $actual >= $original} {
        ppa_fail "represented library cap $actual is not strictly below original $original"
    }
}

proc ppa_cap_apply {scale} {
    set pins [get_lib_pins -quiet "$::LIB_NAME/*/*"]
    foreach_in_collection pin $pins {
        set direction [get_attribute $pin direction]
        if {$direction ni {out inout}} {continue}
        if {[catch {get_attribute -quiet $pin max_capacitance} original] || [string trim $original] eq ""} {
            incr ::PPA_CAP_SKIPPED
            continue
        }
        if {![string is double -strict $original] || !($original > 0 && $original < Inf)} {
            ppa_fail "output library pin has no finite positive max_capacitance"
        }
        set target [expr {$scale * $original}]
        if {$target <= 0 || $target >= $original} {ppa_fail "cap scale does not produce a positive tighter limit"}
        set name [get_object_name $pin]
        # Save before attempting the write: even a false result or bad readback may have edited it.
        lappend ::PPA_CAP_ORIGINALS [list $name $original]
        dict incr ::PPA_CAP_BINS [format %.12g $original]
        ppa_cap_write $pin $target $original
        incr ::PPA_CAP_APPLIED
    }
    if {$::PPA_CAP_APPLIED == 0} {ppa_fail "cap tightening found no positive output library limits"}
}

proc ppa_cap_restore {} {
    set problems {}
    foreach pair $::PPA_CAP_ORIGINALS {
        lassign $pair name original
        if {[catch {
            set pin [get_lib_pins -quiet $name]
            if {[sizeof_collection $pin] != 1} {ppa_fail "restore library pin $name is missing or ambiguous"}
            ppa_cap_write $pin $original
        } detail]} {
            lappend problems "$name: $detail"
        } else {
            incr ::PPA_CAP_RESTORED
        }
    }
    if {[llength $problems]} {ppa_fail "library cap restoration failed: [join $problems {; }]"}
}

proc ppa_compile {} {
    switch -- $::COMPILE_MAP_EFFORT {
        tool_default {ppa_step compile {compile}}
        medium - high {ppa_step compile {compile -map_effort $COMPILE_MAP_EFFORT}}
        default {ppa_fail "unknown compile effort $::COMPILE_MAP_EFFORT"}
    }
}

proc ppa_compile_with_cap_limits {} {
    # No new config/report/library operations for the absent-field baseline (scale = 1).
    set scale 1
    if {[info exists ::MAX_CAPACITANCE_SCALE]} {set scale $::MAX_CAPACITANCE_SCALE}
    if {![string is double -strict $scale] || !($scale > 0 && $scale <= 1)} {ppa_fail "invalid max-capacitance scale"}
    if {$scale == 1} {ppa_compile; return}
    set ::PPA_CAP_ORIGINALS {}
    set ::PPA_CAP_BINS [dict create]
    set ::PPA_CAP_APPLIED 0
    set ::PPA_CAP_RESTORED 0
    set ::PPA_CAP_SKIPPED 0
    set failed [catch {ppa_cap_apply $scale; ppa_compile} detail]
    # Always attempt every original limit, including after an apply/compile Tcl or tool failure.
    set restore_failed [catch {ppa_cap_restore} restore_detail]
    set content "max_capacitance_scale = $scale\napplied_count = $::PPA_CAP_APPLIED\nrestored_count = $::PPA_CAP_RESTORED\n"
    append content "undefined_output_limit_count = $::PPA_CAP_SKIPPED\n"
    append content "readback_model = float32 storage, six-decimal report; exact represented comparison\n"
    foreach limit [lsort -real [dict keys $::PPA_CAP_BINS]] {
        append content "original_limit_bin = $limit count=[dict get $::PPA_CAP_BINS $limit]\n"
    }
    append content "compile_status = [expr {$failed ? {FAILED_OR_NOT_RUN} : {COMPLETED}}]\n"
    if {$failed} {append content "compile_or_apply_error = $detail\n"}
    append content "final_library_limits = [expr {$restore_failed ? {RESTORE_FAILED} : {ORIGINAL}}]\n"
    append content "final_reports_and_handoff = original library limits required; PT reads original .db\nlibrary_file_write = NONE\n"
    ppa_write reports/dc_cap_optimization.rpt $content
    if {$restore_failed} {ppa_fail $restore_detail}
    if {$failed} {ppa_fail $detail}
}

proc ppa_syn {} {
    ppa_check_profile_library
    ppa_apply_methodology
    ppa_apply_constraints
    ppa_profile_report
    ppa_report check_design_pre.rpt {check_design} 0
    ppa_report check_timing_pre.rpt {check_timing} 0
    ppa_compile_with_cap_limits
    ppa_report check_design_post.rpt {check_design} 0
    ppa_report check_timing_post.rpt {check_timing} 0
    # -significant_digits 6 (observed accepted by W-2024.09 DC) keeps ~0.001 slew violations visible.
    set area [ppa_report area.rpt {report_area}]
    ppa_report area_hier.rpt {report_area -hierarchy}
    ppa_report reference.rpt {report_reference -hierarchy}
    ppa_report qor.rpt {report_qor}
    ppa_report dc_timing_max.rpt {report_timing -delay_type max -max_paths 20 -significant_digits 6}
    ppa_report dc_timing_min.rpt {report_timing -delay_type min -max_paths 20 -significant_digits 6}
    ppa_report dc_constraints.rpt {report_constraint -all_violators -significant_digits 6}
    ppa_report dc_clocks.rpt {report_clock}
    ppa_report syn_design.rpt {report_design}
    ppa_area_summary $area
    ppa_structure_check syn_structure.rpt post_compile report
    ppa_step change_names {change_names -rules verilog -hierarchy}
    ppa_step write_netlist {write -format verilog -hierarchy -output $NETLIST_FILE}
    ppa_step write_sdc {write_sdc $SDC_FILE}
    foreach path [list $::NETLIST_FILE $::SDC_FILE] {
        if {![file isfile $path] || [file size $path] == 0} {ppa_fail "$path was not written"}
    }
}

proc ppa_main {} {
    file mkdir reports output
    ppa_write $::PPA_STEPS "# DC steps for $::RUN_NAME ($::PPA_MODE)\n"
    # One fixed host limit for every policy/N; do not inherit a changing site default.
    ppa_step host_options {set_host_options -max_cores 1}
    set version_prefix "tcl_patchlevel = [info patchlevel]\nexecutable = [info nameofexecutable]\n"
    ppa_variable_report dc_versions.rpt {sh_product_version sh_arch} $version_prefix
    ppa_command_inventory dc_commands.rpt {
        read_db list_libs report_lib get_libs get_attribute analyze elaborate rename_design link
        current_design check_design check_timing compile compile_ultra set_operating_conditions
        set_wire_load_model set_wire_load_mode set_zero_interconnect_delay_mode report_area
        report_reference report_qor report_timing report_constraint report_design report_hierarchy
        report_port report_units change_names write write_sdc all_registers redirect report_power read_saif
    }
    ppa_step search_path {set_app_var search_path [concat [list $RUN_ROOT [file dirname $TARGET_LIBRARY]] $search_path]}
    ppa_step target_library {set_app_var target_library [list $TARGET_LIBRARY]}
    ppa_step link_library {set_app_var link_library [concat [list *] [list $TARGET_LIBRARY]]}
    ppa_library_facts
    ppa_elaborate
    ppa_units dc_units.rpt
    ppa_library_metadata
    ppa_variable_report dc_app_vars.rpt {
        target_library link_library synthetic_library search_path auto_wire_load_selection
        hdlin_infer_multibit compile_seqmap_propagate_constants compile_delete_unloaded_sequential_cells
        compile_enable_register_merging hdlin_sverilog_std
    }
    ppa_report elab_design.rpt {report_design}
    ppa_report elab_hierarchy.rpt {report_hierarchy -noleaf}
    ppa_report elab_ports.rpt {report_port -verbose}
    ppa_report elab_check_design.rpt {check_design} 0
    ppa_structure_check elab_structure.rpt elaborated bounds
    if {$::PPA_MODE eq "syn"} {ppa_syn}
    ppa_write reports/dc_status.rpt [format "DC_STATUS: COMMANDS_COMPLETED\nMODE: %s\nRUN: %s\nTOP: %s\nELAB_PARAMETERS: %s\n" \
        $::PPA_MODE $::RUN_NAME $::TOP_MODULE $::ELAB_PARAMETERS]
}

if {[catch {ppa_main} ppa_detail]} {
    puts "[ppa_fail_tag]: $ppa_detail"
    exit 1
}
exit 0
